# Copiar a .env antes de ejecutar: cp .env.example .env
# Valores de PRUEBA para el entorno local. Cambiarlos en cualquier otro entorno.

# Kafka (identificador del clúster KRaft, igual en los 3 nodos)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092

# PostgreSQL + TimescaleDB
POSTGRES_DB=movia
POSTGRES_USER=movia
POSTGRES_PASSWORD=movia_pg_local
POSTGRES_HOST=postgres

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=movia_redis_local

# Seguridad
JWT_SECRET=cambiar_este_secreto_local_de_32_caracteres_min
JWT_EXPIRA_MIN=15
INGESTA_API_KEY=clave_dispositivos_local

# Usuarios semilla (uno por rol)
ADMIN_CORREO=admin@movia.test
ADMIN_CLAVE=Admin2026*
OPERADOR_CORREO=operador@movia.test
OPERADOR_CLAVE=Operador2026*
CIUDADANO_CORREO=ciudadano@movia.test
CIUDADANO_CLAVE=Ciudadano2026*

# Simulador de flota
SIM_BUSES=25
SIM_INTERVALO_MS=1000
SIM_PROB_INCIDENCIA=0.0002
INGESTA_URL=http://ingesta:8080
AUTH_URL=http://auth:3000
